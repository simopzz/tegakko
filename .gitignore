
# Skills installed with `npx skills install` from skills-lock.json, kept per machine;
# a skill this repo owns gets an exception here.
.agents/skills/*
.claude/skills/*
skills-lock.json
.claude/settings.local.json

# Snapshots and network captures the Playwright MCP server writes.
.playwright-mcp/

# app build tooling
node_modules
dist
dev-dist
*.local
.vite
coverage

# OS / editor cruft
.DS_Store
*.log
.env

# Agent skills (installed tooling, not project source)
# .agents is the canonical install dir; the others are per-agent copies/symlinks.
.agent/skills/*
.agents/skills/*
.claude/skills/*
.gemini/skills/*
.hermes/skills/*
.opencode/skills/*
.pi/skills/*

# Impeccable skill extras (hook/config files written at install time)
.impeccable/config.local.json
.impeccable/hook.cache.json
.claude/agents/impeccable-*.md
.claude/settings.local.json
.codex/hooks.json
.gemini/settings.json
.opencode/commands/impeccable.md
