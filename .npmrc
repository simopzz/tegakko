# typescript-eslint 8.69.0 and svelte-check 4.7.6 (latest as of this
# scaffold) both hard-refuse to run against TypeScript >=7 (see
# scripts/link-ts6-for-eslint.sh). Their peer ranges (<6.1.0, and ^5||^6
# respectively) conflict with this project's pinned TypeScript 7.0.2 --
# package.json's `overrides` force a compatible nested `typescript` copy
# under each tool's own subtree, but npm's strict resolver only accepts
# those overrides with --force: without it, npm ERESOLVE-fails outright
# (verified 2026-09-03 by removing this line and running a clean
# `rm -rf node_modules package-lock.json && npm install`) because
# svelte-check declares typescript as a direct peerDependency, not just a
# transitive one satisfied by hoisting. Setting it here keeps `npm install`
# (no flags) reproducible for anyone cloning the repo. This is a targeted,
# understood conflict, not a blanket safety net -- if a future unrelated
# peer-dependency conflict appears, `npm install` will still surface it as
# an ERESOLVE warning (just not a hard failure), so watch install output
# rather than assuming force=true silences everything.
force=true
